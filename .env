# Worknest API Configuration

# Server Configuration
PORT=3000

# Database Configuration
WORKNEST_DB_PATH=./worknest.db

# JWT Secret Key (Change in production!)
# Generate with: openssl rand -base64 32
WORKNEST_SECRET_KEY=dev-secret-key-please-change-in-production-use-random-key

# Logging Level
RUST_LOG=worknest_api=debug,tower_http=debug

# Agents subsystem (all optional — sensible defaults are auto-detected)
#
# Override the auto-resolved path to the in-repo `worknest-mcp/` directory.
# Only needed when the `worknest-api` binary runs from outside a checkout
# (deployed binaries, packaged builds, CI, etc.).
# WORKNEST_AGENT_MCP_DIR=/abs/path/to/worknest-mcp
#
# Where per-deployment workspaces live. Default: $HOME/.local/share/worknest/agents
# WORKNEST_AGENTS_DIR=/abs/path/to/agents-dir
#
# `claude` CLI binary. Resolved via PATH unless absolute. Default: claude
# WORKNEST_CLAUDE_BIN=claude
#
# Public URL the MCP server uses to reach the API. Default: http://localhost:$PORT
# WORKNEST_PUBLIC_URL=http://localhost:3000
#
# Hard ceiling per tick subprocess, in seconds. Default: 600
# WORKNEST_AGENT_TICK_TIMEOUT_SECS=600
